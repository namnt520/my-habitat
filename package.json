{
  "name": "my-habitat",
  "private": true,
  "version": "0.1.0",
  "description": "Mô phỏng hệ sinh thái tiến hoá chạy trên trình duyệt",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.sim.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "sim": "node scripts/run.mjs scripts/sim.ts",
    "stability": "node scripts/run.mjs scripts/stability.ts",
    "bench": "node scripts/run.mjs scripts/bench.ts",
    "lv": "node scripts/run.mjs scripts/lotka.ts"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
